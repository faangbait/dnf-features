{
    "name": "AWS CLI (RHEL)",
    "id": "aws-cli",
    "version": "1.0.2",
    "description": "Installs the AWS CLI along with needed dependencies. Best-efforts a dnf install.",
    "documentationURL": "https://github.com/faangbait/dnf-features/tree/main/src/aws-cli",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "latest"
            ],
            "default": "latest",
            "description": "Select or enter an AWS CLI version."
        },
        "verbose": {
            "type": "boolean",
            "default": true,
            "description": "Suppress verbose output."
        }
    },
    "customizations": {},
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
