{
    "name": "AWS CLI (RHEL)",
    "id": "aws-cli",
    "version": "1.0.4",
    "description": "Installs AWS CLI v2 and shell completion with dnf, microdnf, yum, apt, or apk support.",
    "documentationURL": "https://github.com/faangbait/dnf-features/tree/main/src/aws-cli",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "latest"
            ],
            "default": "latest",
            "description": "Select or enter an AWS CLI version."
        },
        "verbose": {
            "type": "boolean",
            "default": true,
            "description": "Show verbose archive extraction output."
        }
    },
    "customizations": {},
    "installsAfter": [
        "ghcr.io/devcontainers/features/common-utils"
    ]
}
